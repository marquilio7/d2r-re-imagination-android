build/
build-*/
dist/
# Lo que arma scripts/package-release.sh (se sube como descarga, no al repo)
/publicar/

# Archivos extraídos de tu copia de Diablo II: Resurrected. Nunca se suben.
data/
*.mpq
*.dcc
*.dc6
*.dt1
*.ds1
*.sprite
# Las cinemáticas (las del juego y las convertidas por el importador)
*.webm
*.mpg
# Los dibujos editados que carga el port en lugar del DCC (la skin personal del
# Brujo y sus herramientas no se publican: quedan solo en la copia local)
*.d2rw
/docs/publicar/README-warlock.md
/docs/publicar/instalar-brujo.*
/tools/sprites_export.py
/tools/sprites_import.py
/tools/hd_icons.py
/herramientas-sprites/

*.bmp
*.png

# Los dibujos exportados para editar y los .sprite editados (solo locales)
editar/
mod/

# Partidas guardadas en la PC
save/
# Lo que deja el importador en la carpeta del código (el idioma elegido y lo que faltó)
/idioma.txt
/importar.log
prof/

# Registros de las pruebas y la configuración local de Claude Code
*.log
.claude/

# Configuración local de Android (ruta del SDK de cada máquina)
android/local.properties
# Intermediarios de build de Android (se regeneran)
android/.gradle/
android/app/build/
# SDL2: se descarga aparte (ver README / android/). No se sube.
android/app/jni/SDL/
# Junction local para que ndk-build resuelva los paths (no se sube)
android/app/jni/port/
# Keystore de firma (no se sube: cada uno genera el suyo)
android/app/*.keystore
android/app/*.jks
# Version del build (se regenera con compilar-android.ps1)
android/app/jni/src/.d2version
gmon.out
*.wav
